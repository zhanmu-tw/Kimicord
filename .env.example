# Discord Bot Credentials
# Get these from https://discord.com/developers/applications -> Your App -> Bot / General Information
DISCORD_TOKEN=your_bot_token_here
DISCORD_APP_ID=your_application_id_here

# Guild ID for instant slash-command registration (optional but recommended).
# If set, commands register to this server immediately instead of taking up to 1 hour globally.
GUILD_ID=

# Comma-separated list of Discord user IDs allowed to interact with the bot.
ALLOWED_USER_IDS=

# Channel IDs where the bot operates in "channel" mode.
# Append :mention to only respond when @mentioned; omit or use :any to respond to all messages.
CHANNEL_MODE_IDS=

# Channel IDs where the bot operates in "forum" mode (auto-responds to new forum posts).
#FORUM_MODE_IDS=

# Working directory passed to kimi sessions (default: /workspace).
KIMI_WORK_DIR=/workspace

# Default LLM model used by kimi-cli (default: kimi-k2.5).
KIMI_MODEL=kimi-k2.5

# Enable YOLO mode in kimi (auto-approve tools without confirmation). true / false (default: false).
KIMI_YOLO=false

# Idle time in milliseconds before an inactive kimi session is torn down (default: 1800000 = 30 min).
SESSION_IDLE_TIMEOUT_MS=1800000

# Show <think> spoilers in Discord output. true / false (default: false).
SHOW_THINKING=false

# Show the persistent status embed at the start of each turn. true / false (default: false).
SHOW_STATUS_EMBED=false

# Port for the built-in HTTP dashboard (default: 3000).
DASHBOARD_PORT=3000

# Optional API key to protect the HTTP dashboard.
DASHBOARD_API_KEY=

# Path to the MCP configuration file (default: /app/data/mcp.json).
MCP_CONFIG_PATH=/app/data/mcp.json
